# Copia este archivo a .env.local y llena los valores.
# .env.local no se sube a git.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://TU_PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_llave_publica_anon

# Supabase → Project Settings → API → service_role (secreta, solo servidor)
SUPABASE_SERVICE_ROLE_KEY=tu_llave_de_servicio

# Dirección pública del sitio, sin barra al final. En local: http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Nombre que ve el comensal
NEXT_PUBLIC_RESTAURANT_NAME=La Ceiba

# mock = sin Pey (botón "Simular pago"). live = Pey real.
PEY_MODE=mock

# Solo si PEY_MODE=live. Portal Pey → Developer.
PEY_API_KEY=
# Secreto whsec_… del webhook. Solo servidor.
PEY_WEBHOOK_SECRET=

# Activo salvo que valga exactamente false.
# Mientras la cuenta receptora sea la de prueba de Pey, NUNCA pongas false:
# el dinero enviado a esa cuenta no se devuelve. Con true, Pey cobra $0.01.
DEMO_MODE=true

# PIN compartido de la caja. Si falta en producción, la caja no se abre.
CASHIER_PIN=
